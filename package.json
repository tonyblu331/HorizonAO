    "typecheck:tsgo": "pnpm -r typecheck:tsgo"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@typescript/native-preview": "7.0.0-dev.20260516.1",
    "oxlint": "1.67.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
