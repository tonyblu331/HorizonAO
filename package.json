{
  "name": "horizonao",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @horizonao/demo dev",
    "lint": "oxlint . --deny-warnings",
