# Enforce LF for all text files repo-wide so source-contract tests (which assert
# multiline `\n` substrings via Vite `?raw` imports) are stable across platforms.
# Pairs with the `raw-lf-normalize` Vite plugin in vitest.config.ts.
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.glb  binary
*.bin  binary
*.ktx2 binary
*.hdr  binary
*.exr  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.mp4  binary
*.wasm binary
